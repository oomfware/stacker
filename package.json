{
	"name": "@oomfware/stacker",
	"version": "0.2.5",
	"description": "type-safe stack router for React",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "https://codeberg.org/oomfware/stacker"
	},
	"files": [
		"dist/"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./testing": {
			"types": "./dist/testing.d.mts",
			"default": "./dist/testing.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "oxlint && tsdown",
		"dev": "tsdown --watch",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"play": "vite",
		"prepublishOnly": "pnpm run build",
		"test": "vitest run",
		"test:types": "vitest run --typecheck.only",
		"test:watch": "vitest",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@mary-ext/simple-event-emitter": "^1.1.0"
	},
	"devDependencies": {
		"@mary-ext/oxlint-rules": "^0.1.2",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"@vitest/browser-playwright": "^5.1.0",
		"bumpp": "^12.3.0",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"playwright": "^1.65.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	}
}
